# Пример конфигурационного файла микросервиса.
# Запуск: java -jar J1-all.jar server --config server.properties
# Параметры командной строки имеют приоритет над значениями из этого файла.

# Ключ подписи и сертификат удостоверяющего центра (создаются заранее: java -jar J1-all.jar gen-ca)
ca-key=ca.key
ca-cert=ca.crt

# Issuer Name выдаваемых сертификатов.
# Если не задан, берётся Subject Name из сертификата УЦ.
issuer=CN=DPS Key Service CA, O=NSU, C=RU

# Сетевые параметры
bind=0.0.0.0
port=9000
backlog=512

# Нити: генерирующие и обслуживающие ввод-вывод
threads=8
io-threads=1

# Параметры выдаваемых ключей и сертификатов
key-size=8192
validity-days=365
